# Application Configuration
SERVER_PORT=8080
SERVER_HOST=0.0.0.0

# Database Configuration
DATABASE_URL=postgresql://db_user:db_pass@pg:5432/hyperswitch_db

# Redis Configuration
REDIS_URL=redis://redis-standalone:6379

# Logging
LOG_LEVEL=DEBUG
LOG_CONSOLE_ENABLED=true
LOG_TELEMETRY_ENABLED=true

# Secrets
# IMPORTANT: Generate secure random strings for these in production!
ADMIN_API_KEY=admin_api_key_placeholder
JWT_SECRET=jwt_secret_placeholder
